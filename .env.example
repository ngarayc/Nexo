# Generar valores independientes con: bash scripts/configure-local.sh
# Este archivo es documentación; no contiene credenciales utilizables.
DB_NAME=nexo
DB_HOST=db
DB_PASSWORD=
DB_OWNER_PASSWORD=
SESSION_SECRET=
INGEST_API_KEY=
DEMO_ENABLED=true
