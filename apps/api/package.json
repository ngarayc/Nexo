{
  "name": "@nexo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run --config vitest.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:prepare": "node dist/platform/database/migrate-main.js"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "argon2": "0.45.1",
    "csrf-sync": "4.2.1",
    "drizzle-orm": "0.45.4",
    "express-rate-limit": "8.7.1",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "jsonc-parser": "3.3.1",
    "memorystore": "1.6.8",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
