{
  "name": "@nexo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build --workspace @nexo/contracts && ng build",
    "start": "npm run build --workspace @nexo/contracts && ng serve --host 127.0.0.1 --port 4200",
    "typecheck": "npm run build --workspace @nexo/contracts && ngc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "test:unit": "npm run build --workspace @nexo/contracts && ng test --watch=false"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "@nexo/contracts": "0.1.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3"
  }
}
