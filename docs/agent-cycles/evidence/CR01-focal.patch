+// El parser permisivo de query strings puede sustituir UTF-8/escapes inválidos.
+// Decodificar aquí permite rechazarlos sin cambiar la identidad ni otros GET.
+function readAlertFilter(url: string): string | undefined {
+  const offset = url.indexOf('?');
+  if (offset === -1) return undefined;
+  let vehicleId: string | undefined;
+  for (const field of url.slice(offset + 1).split('&')) {
+    if (field === '') continue;
+    const separator = field.indexOf('=');
+    const rawName = separator === -1 ? field : field.slice(0, separator);
+    const rawValue = separator === -1 ? '' : field.slice(separator + 1);
+    let name: string, value: string;
+    try {
+      name = decodeURIComponent(rawName.replace(/\+/g, ' '));
+      value = decodeURIComponent(rawValue.replace(/\+/g, ' '));
+    } catch {
+      throw new InvalidQuery();
+    }
+    if (name !== 'vehicleId' || vehicleId !== undefined) throw new InvalidQuery();
+    vehicleId = readVehicleId(value);
+  }
+  return vehicleId;
+}
