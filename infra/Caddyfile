{
  admin off
  servers {
    protocols h1 h2
  }
}

{$NEXO_DOMAIN} {
  header Strict-Transport-Security "max-age=31536000"
  reverse_proxy web:8080 {
    header_up Host localhost
    header_up -Forwarded
    header_up -X-Forwarded-For
    header_up -X-Forwarded-Host
    header_up -X-Real-IP
    flush_interval -1
  }
}
